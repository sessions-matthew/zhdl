//! Pipelined DSP Multiply-Accumulator with Black Box Primitive Integration
//!
//! Demonstrates:
//! 1. 'extern("DSP48E1", .{ .include = "..." }) module' black box primitive declaration.
//! 2. Module parameter definition and compile-time override on instantiation.
//! 3. Pipelined accumulator with reset and synchronous clear.
//! 4. First-class frequency simulation (100MHz) and assertion verification.

pub const XilinxDsp = extern("DSP48E1", .{ .include = "examples/xilinx_dsp48e1.v" }) module {
    const A_WIDTH: u32 = 25;
    const B_WIDTH: u32 = 18;

    in clk: clock,
    in a: u25,
    in b: u18,
    out p: u43,
};

pub module DspMac {
    in clk: clock,
    in rst: reset,
    in clear: u1,
    in data_a: u25,
    in data_b: u18,
    out accum: u48,

    wire mult_result: u43;
    reg accum_q: u48 = 0;

    // Instantiate vendor black box DSP multiplier with parameter overrides
    const u_dsp = XilinxDsp.instantiate(
        .{ .A_WIDTH = 25, .B_WIDTH = 18 },
        .{
            .clk = clk,
            .a = data_a,
            .b = data_b,
            .p = mult_result,
        },
    );

    comb {
        if (clear) {
            accum_q := 0;
        } else {
            // Accumulate 43-bit product zero-extended to 48-bit accumulator
            accum_q := accum_q +% @as(u48, mult_result);
        }
    }

    accum = accum_q;
}

test "DspMac accumulates multiple products" {
    var clk = clock(100MHz);
    var rst = reset();
    wire clear: u1;
    wire data_a: u25;
    wire data_b: u18;
    wire accum: u48;

    const dut = DspMac.instantiate(.{
        .clk = clk,
        .rst = rst,
        .clear = clear,
        .data_a = data_a,
        .data_b = data_b,
        .accum = accum,
    });

    trace("dsp_mac_tb.vcd");

    rst.pulse(2, clk);
    clear = 1;
    data_a = 0;
    data_b = 0;
    clk.step(1);
    assert(accum == 0, "Accumulator should be cleared");

    clear = 0;
    // Cycle 1: present data_a = 10, data_b = 5 -> mult_result = 50
    data_a = 10;
    data_b = 5;
    clk.step(1);
    assert(accum == 50, "Accumulator should reach 50");

    // Cycle 2: present data_a = 20, data_b = 3 -> mult_result = 60, accum = 50 + 60 = 110
    data_a = 20;
    data_b = 3;
    clk.step(1);
    assert(accum == 110, "Accumulator should reach 110");

    // Cycle 3: clear accumulator
    clear = 1;
    clk.step(1);
    assert(accum == 0, "Accumulator should clear to 0");
    finish();
}

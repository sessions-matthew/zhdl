//! Signed Fixed-Point Digital Signal Processor (DSP) with Saturating Clamp
//!
//! Demonstrates:
//! 1. Signed bit-vectors ('i8', 'i16', 'i32') and SystemVerilog 'logic signed' emission.
//! 2. Signed arithmetic: multiplication ('*'), addition ('+%'), and subtraction ('-%').
//! 3. Signed relational comparisons ('< 0', '> 0', '<=', '>=').
//! 4. Two's complement symmetric saturation (clamping on positive/negative overflow).
//! 5. Fixed-point arithmetic and scaling.
//! 6. Cycle-accurate simulation verifying bipolar impulse responses.

pub module SignedDspMac {
    in clk: clock,
    in rst: reset,

    in sample_in: i16,
    in coeff: i8,
    in clear: u1,

    out product: i32,
    out acc_out: i16,
    out is_negative: u1,
    out is_saturated: u1,

    reg r_acc: i16 = 0;
    reg r_sat: u1 = 0;

    // 1. Signed multiplication: 16-bit * 8-bit -> 32-bit signed product
    wire prod32: i32 = @as(i32, sample_in) * @as(i32, coeff);

    // 2. Fixed-point Q1.7 scaling (shift right by 7 bits)
    wire scaled_term: i16 = @truncate(i16, prod32 >> 7);

    // 3. Saturating accumulator logic
    // Theoretical next value without clamping:
    wire next_sum: i32 = @as(i32, r_acc) + @as(i32, scaled_term);

    // Detect signed overflow beyond [-30000, +30000] safety threshold
    wire pos_overflow: u1 = (next_sum > 30000);
    wire neg_overflow: u1 = (next_sum < -30000);

    if (clear) {
        r_acc := 0;
        r_sat := 0;
    } else if (pos_overflow) {
        r_acc := 30000;
        r_sat := 1;
    } else if (neg_overflow) {
        r_acc := -30000;
        r_sat := 1;
    } else {
        r_acc := @truncate(i16, next_sum);
        r_sat := 0;
    }

    product = prod32;
    acc_out = r_acc;
    is_negative = (r_acc < 0);
    is_saturated = r_sat;
}

test "SignedDspMac handles signed arithmetic, negative products, and saturation" {
    wire clk: clock;
    wire rst: reset;

    wire sample_in: i16;
    wire coeff: i8;
    wire clear: u1;

    wire product: i32;
    wire acc_out: i16;
    wire is_negative: u1;
    wire is_saturated: u1;

    const dut = SignedDspMac.instantiate(.{
        .clk = clk,
        .rst = rst,
        .sample_in = sample_in,
        .coeff = coeff,
        .clear = clear,
        .product = product,
        .acc_out = acc_out,
        .is_negative = is_negative,
        .is_saturated = is_saturated,
    });

    trace("signed_dsp_tb.vcd");
    clk.generate(100MHz);
    rst.pulse(2);

    // 1. Multiply positive sample (1000) by positive coeff (64, i.e. 0.5 in Q1.7)
    // 1000 * 64 = 64000. Scaled: 64000 >> 7 = 500.
    clk.negedge();
    clear = 0;
    sample_in = 1000;
    coeff = 64;
    clk.posedge();
    delay(1);
    assert(product == 64000, "1000 * 64 == 64000");

    clk.negedge();
    // 2. Multiply negative sample (-1000) by positive coeff (64)
    // -1000 * 64 = -64000. Scaled: -500. Accumulator should cancel: 500 + (-500) = 0.
    sample_in = -1000;
    coeff = 64;
    clk.posedge();
    delay(1);
    assert(product == -64000, "-1000 * 64 == -64000");
    assert(is_negative == 0, "Zero accumulator is not negative");

    // 3. Multiply negative sample (-500) by negative coeff (-64, i.e. -0.5)
    // (-500) * (-64) = +32000. Negative * negative = positive!
    clk.negedge();
    sample_in = -500;
    coeff = -64;
    clk.posedge();
    delay(1);
    assert(product == 32000, "(-500) * (-64) == +32000");

    // 4. Force positive saturation: accumulate large values beyond +30000
    clk.negedge();
    sample_in = 16000;
    coeff = 127; // Max positive coeff ~1.0
    clk.posedge(); // acc becomes ~16000

    clk.negedge();
    sample_in = 16000;
    coeff = 127;
    clk.posedge(); // acc would exceed 30000 -> clamps to 30000
    delay(1);
    assert(acc_out == 30000, "Accumulator clamped to positive rail +30000");
    assert(is_saturated == 1, "Saturation flag asserted on positive overflow");

    // 5. Clear accumulator
    clk.negedge();
    clear = 1;
    clk.posedge();
    delay(1);
    assert(acc_out == 0, "Accumulator cleared to 0");
    assert(is_saturated == 0, "Saturation flag cleared");

    // 6. Force negative saturation: accumulate large negative values beyond -30000
    clk.negedge();
    clear = 0;
    sample_in = -16000;
    coeff = 127;
    clk.posedge();

    clk.negedge();
    sample_in = -16000;
    coeff = 127;
    clk.posedge(); // Clamps to -30000
    delay(1);
    assert(acc_out == -30000, "Accumulator clamped to negative rail -30000");
    assert(is_negative == 1, "Negative flag asserted when acc < 0");
    assert(is_saturated == 1, "Saturation flag asserted on negative overflow");

    finish();
}

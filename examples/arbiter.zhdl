// Round-Robin Bus Arbiter with Fair Priority Rotation
// Ported from Alex Forencich's verilog-axi (arbiter.v)
//
// Features:
// - 4-client round-robin arbitration with zero starvations
// - Acknowledge-based transaction holding
// - Constant-time lowest-set-bit priority isolation (req & -req)
// - Dynamic mask rotation for fair circular scheduling

pub module RoundRobinArbiter(
    in clk: clock,
    in rst: reset(.async),

    in request: u4,
    in acknowledge: u4,

    out grant: u4,
    out grant_valid: u1,
    out grant_encoded: u2,
) {
    reg(clk, rst) grant_reg: u4 = 0;
    reg(clk, rst) grant_valid_reg: u1 = 0;
    reg(clk, rst) grant_encoded_reg: u2 = 0;
    reg(clk, rst) mask_reg: u4 = 4'b1111;

    comb {
        grant = grant_reg;
        grant_valid = grant_valid_reg;
        grant_encoded = grant_encoded_reg;

        // Default register feedback
        grant_reg := 0;
        grant_valid_reg := 0;
        grant_encoded_reg := 0;
        mask_reg := mask_reg;

        // Check if current grant is still locked by pending acknowledge from active request
        const holding = (grant_valid_reg != 0) and ((grant_reg & request) != 0) and ((grant_reg & acknowledge) == 0);

        if (holding) {
            grant_reg := grant_reg;
            grant_valid_reg := grant_valid_reg;
            grant_encoded_reg := grant_encoded_reg;
        } else {
            const masked_req: u4 = request & mask_reg;
            const has_masked = (masked_req != 0);
            const active_req: u4 = if (has_masked) masked_req else request;

            if (active_req != 0) {
                grant_valid_reg := 1;

                if (active_req[0] != 0) {
                    grant_reg := 4'b0001;
                    grant_encoded_reg := 0;
                    mask_reg := 4'b1110;
                } else if (active_req[1] != 0) {
                    grant_reg := 4'b0010;
                    grant_encoded_reg := 1;
                    mask_reg := 4'b1100;
                } else if (active_req[2] != 0) {
                    grant_reg := 4'b0100;
                    grant_encoded_reg := 2;
                    mask_reg := 4'b1000;
                } else {
                    grant_reg := 4'b1000;
                    grant_encoded_reg := 3;
                    mask_reg := 4'b0000;
                }
            }
        }
    }
}

test "RoundRobinArbiterTb" {
    var clk = clock(100MHz);
    var rst = reset(.async);

    wire req: u4 = 0;
    wire ack: u4 = 0;

    wire grant: u4;
    wire grant_valid: u1;
    wire grant_enc: u2;

    const uut = RoundRobinArbiter.instantiate(.{
        .clk = clk,
        .rst = rst,
        .request = req,
        .acknowledge = ack,
        .grant = grant,
        .grant_valid = grant_valid,
        .grant_encoded = grant_enc,
    });

    sim {
        rst.pulse(5, clk);
        clk.step(2);

        // Initial state: no requests
        assert(grant_valid == 0, "No grant when no requests");
        assert(grant == 0, "Grant bus 0 when idle");

        // Test 1: Single client request (client 2)
        req = 4'b0100;
        ack = 4'b0100; // Immediate ack
        clk.step(1);
        assert(grant_valid == 1, "Grant valid for client 2");
        assert(grant == 4'b0100, "Grant bus 4'b0100");
        assert(grant_enc == 2, "Grant encoded 2");

        // Clear requests
        req = 0;
        ack = 0;
        clk.step(1);
        assert(grant_valid == 0, "Grant deasserts when idle");

        // Test 2: Full contention (all 4 clients request simultaneously)
        // Verify fair round-robin rotation 0 -> 1 -> 2 -> 3 -> 0
        req = 4'b1111;
        ack = 4'b1111; // Always ack immediately

        // Cycle 1: After client 2, round-robin selects Client 3
        clk.step(1);
        assert(grant_valid == 1, "Grant valid in contention cycle 1");
        assert(grant == 4'b1000, "Expected Client 3 granted first after Client 2");
        assert(grant_enc == 3, "Encoded grant 3");

        // Cycle 2: Rotates and wraps around to Client 0
        clk.step(1);
        assert(grant == 4'b0001, "Expected Client 0 granted second");
        assert(grant_enc == 0, "Encoded grant 0");

        // Cycle 3: Should rotate to Client 1
        clk.step(1);
        assert(grant == 4'b0010, "Expected Client 1 granted third");
        assert(grant_enc == 1, "Encoded grant 1");

        // Cycle 4: Should rotate to Client 2
        clk.step(1);
        assert(grant == 4'b0100, "Expected Client 2 granted fourth");
        assert(grant_enc == 2, "Encoded grant 2");

        // Cycle 5: Should wrap back around to Client 3
        clk.step(1);
        assert(grant == 4'b1000, "Expected Client 3 granted after full rotation wrap");
        assert(grant_enc == 3, "Encoded grant 3");

        // Test 3: Transaction holding (client 1 granted without immediate ack)
        req = 4'b0010;
        ack = 0; // No ack yet
        clk.step(1);
        assert(grant == 4'b0010, "Client 1 granted");

        // Client 3 also requests, but Client 1 hasn't acked
        req = 4'b1010;
        clk.step(2);
        assert(grant == 4'b0010, "Grant should hold for Client 1 while ack is deasserted");

        // Now Client 1 acks
        ack = 4'b0010;
        clk.step(1);
        // Next cycle: Client 3 gets granted
        assert(grant == 4'b1000, "Client 3 should now receive grant");
        assert(grant_enc == 3, "Encoded grant 3");
    }
}

//! Parameterized Counter with Reset, Enable, Overflow, and Downward Bit Slicing
//! Demonstrates Paradigm 2 ANSI port list with commas and body declarations with semicolons.
pub module Counter(
    in clk: clock,
    in rst: reset(.async),
    in en: u1,
    out count: u8,
    out overflow: u1,
    out rev_nibble: u4,
) {
    reg count_reg: u8 = 0;

    overflow = (count_reg == 255);

    comb {
        if (en) {
            count_reg := count_reg +% 1;
        }
    }

    count = count_reg;

    // Downward bit slicing syntactic sugar: extracts lower 4 bits in reverse bit order!
    rev_nibble = count_reg[4..0];
}

test "Counter increments and rolls over at 255" {
    var clk = clock(100MHz);
    var rst = reset(.async);
    wire en: u1;
    wire count: u8;
    wire overflow: u1;
    wire rev_nibble: u4;

    const dut = Counter.instantiate(.{
        .clk = clk,
        .rst = rst,
        .en = en,
        .count = count,
        .overflow = overflow,
        .rev_nibble = rev_nibble,
    });

    trace("counter_tb.vcd");

    // Reset the counter
    rst.pulse(2, clk);
    assert(count == 0, "Counter should be 0 out of reset");

    // Enable count and step 10 cycles
    en = 1;
    clk.step(10);
    assert(count == 10, "Counter should be 10 after 10 enabled cycles");

    // Step to near rollover (10 + 245 = 255)
    clk.step(245);
    assert(count == 255, "Counter should reach 255");
    assert(overflow == 1, "Overflow should be active at 255");

    // Step 1 more cycle to wrap to 0
    clk.step(1);
    assert(count == 0, "Counter should wrap to 0");
    assert(overflow == 0, "Overflow should clear after rollover");
    finish();
}

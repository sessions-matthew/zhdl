// AXI4-Stream UART Transmitter and Receiver ported from Alex Forencich's verilog-uart
// Features:
// - AXI4-Stream valid/ready handshaking
// - Configurable baud rate prescaler (prescale = Fclk / (baud * 8))
// - LHS concatenation register updates: .{ data_reg.next, txd_reg.next } = @concat(0, data_reg)
// - Verified end-to-end loopback transmission and reception in simulation

pub module UartTx(
    in clk: clock,
    in rst: reset(.async),

    in s_axis_tdata: u8,
    in s_axis_tvalid: u1,
    out s_axis_tready: u1,

    out txd: u1,
    out busy: u1,

    in prescale: u16,
) {
    reg(clk, rst) s_axis_tready_reg: u1 = 0;
    reg(clk, rst) txd_reg: u1 = 1;
    reg(clk, rst) busy_reg: u1 = 0;
    reg(clk, rst) data_reg: u9 = 0;
    reg(clk, rst) prescale_reg: u19 = 0;
    reg(clk, rst) bit_cnt: u4 = 0;

    comb {
        s_axis_tready = s_axis_tready_reg;
        txd = txd_reg;
        busy = busy_reg;

        // Default register state feedback
        s_axis_tready_reg := s_axis_tready_reg;
        txd_reg := txd_reg;
        busy_reg := busy_reg;
        data_reg := data_reg;
        prescale_reg := prescale_reg;
        bit_cnt := bit_cnt;

        if (prescale_reg > 0) {
            s_axis_tready_reg := 0;
            prescale_reg := prescale_reg - 1;
        } else if (bit_cnt == 0) {
            s_axis_tready_reg := 1;
            busy_reg := 0;

            if (s_axis_tvalid != 0) {
                s_axis_tready_reg := !s_axis_tready_reg;
                prescale_reg := (@as(u19, prescale) << 3) - 1;
                bit_cnt := 9; // 8 data bits + 1 stop bit
                data_reg := @concat(@as(u1, 1), s_axis_tdata);
                txd_reg := 0;
                busy_reg := 1;
            }
        } else {
            if (bit_cnt > 1) {
                bit_cnt := bit_cnt - 1;
                prescale_reg := (@as(u19, prescale) << 3) - 1;
                .{ data_reg, txd_reg } := .{ @as(u1, 0), data_reg };
            } else if (bit_cnt == 1) {
                bit_cnt := bit_cnt - 1;
                prescale_reg := @as(u19, prescale) << 3;
                txd_reg := 1;
            }
        }
    }
}

pub module UartRx(
    in clk: clock,
    in rst: reset(.async),

    out m_axis_tdata: u8,
    out m_axis_tvalid: u1,
    in m_axis_tready: u1,

    in async rxd: u1,

    out busy: u1,
    out overrun_error: u1,
    out frame_error: u1,

    in prescale: u16,
) {
    reg(clk, rst) m_axis_tdata_reg: u8 = 0;
    reg(clk, rst) m_axis_tvalid_reg: u1 = 0;
    reg(clk, rst) rxd_reg: u1 = 1;
    reg(clk, rst) busy_reg: u1 = 0;
    reg(clk, rst) overrun_error_reg: u1 = 0;
    reg(clk, rst) frame_error_reg: u1 = 0;
    reg(clk, rst) data_reg: u8 = 0;
    reg(clk, rst) prescale_reg: u19 = 0;
    reg(clk, rst) bit_cnt: u4 = 0;

    comb {
        wire rxd_sync = @sync2ff(clk, rxd);

        m_axis_tdata = m_axis_tdata_reg;
        m_axis_tvalid = m_axis_tvalid_reg;
        busy = busy_reg;
        overrun_error = overrun_error_reg;
        frame_error = frame_error_reg;

        // Default register state feedback
        m_axis_tdata_reg := m_axis_tdata_reg;
        m_axis_tvalid_reg := m_axis_tvalid_reg;
        rxd_reg := rxd_sync;
        busy_reg := busy_reg;
        overrun_error_reg := 0;
        frame_error_reg := 0;
        data_reg := data_reg;
        prescale_reg := prescale_reg;
        bit_cnt := bit_cnt;

        if (m_axis_tvalid_reg != 0 and m_axis_tready != 0) {
            m_axis_tvalid_reg := 0;
        }

        if (prescale_reg > 0) {
            prescale_reg := prescale_reg - 1;
        } else if (bit_cnt > 0) {
            if (bit_cnt > 9) {
                if (rxd_reg == 0) {
                    bit_cnt := bit_cnt - 1;
                    prescale_reg := (@as(u19, prescale) << 3) - 1;
                } else {
                    bit_cnt := 0;
                    prescale_reg := 0;
                }
            } else if (bit_cnt > 1) {
                bit_cnt := bit_cnt - 1;
                prescale_reg := (@as(u19, prescale) << 3) - 1;
                data_reg := @concat(rxd_reg, data_reg[1..8]);
            } else if (bit_cnt == 1) {
                bit_cnt := bit_cnt - 1;
                if (rxd_reg != 0) {
                    m_axis_tdata_reg := data_reg;
                    m_axis_tvalid_reg := 1;
                    overrun_error_reg := m_axis_tvalid_reg;
                } else {
                    frame_error_reg := 1;
                }
            }
        } else {
            busy_reg := 0;
            if (rxd_reg == 0) {
                prescale_reg := (@as(u19, prescale) << 2) - 2;
                bit_cnt := 10;
                data_reg := 0;
                busy_reg := 1;
            }
        }
    }
}

test "UartLoopbackTb" {
    var clk = clock(100MHz);
    var rst = reset(.async);

    wire tx_data: u8 = 0;
    wire tx_valid: u1 = 0;
    wire tx_ready: u1;
    wire txd_line: u1;
    wire tx_busy: u1;

    wire rx_data: u8;
    wire rx_valid: u1;
    wire rx_ready: u1 = 0;
    wire rx_busy: u1;
    wire rx_overrun: u1;
    wire rx_frame_err: u1;

    wire prescale: u16 = 4;

    const u_tx = UartTx.instantiate(.{
        .clk = clk,
        .rst = rst,
        .s_axis_tdata = tx_data,
        .s_axis_tvalid = tx_valid,
        .s_axis_tready = tx_ready,
        .txd = txd_line,
        .busy = tx_busy,
        .prescale = prescale,
    });

    const u_rx = UartRx.instantiate(.{
        .clk = clk,
        .rst = rst,
        .m_axis_tdata = rx_data,
        .m_axis_tvalid = rx_valid,
        .m_axis_tready = rx_ready,
        .rxd = txd_line,
        .busy = rx_busy,
        .overrun_error = rx_overrun,
        .frame_error = rx_frame_err,
        .prescale = prescale,
    });

    sim {
        rst.pulse(5, clk);

        // Wait for reset release and transmitter ready
        clk.step(10);
        assert(tx_ready == 1, "Expected UART TX ready after reset");

        // Send byte 0xA5 ('10100101') over UART
        tx_data = 8'hA5;
        tx_valid = 1;
        clk.step(1);
        tx_valid = 0;

        // Wait for frame transmission and reception across serial line
        // Prescale = 4 means 32 clocks per bit, 10 bits = ~320 clocks
        clk.step(350);

        assert(rx_valid == 1, "Expected UART RX valid byte reception");
        assert(rx_data == 8'hA5, "Expected UART RX data to match sent byte 0xA5");
        assert(rx_frame_err == 0, "Expected no frame error");
        assert(rx_overrun == 0, "Expected no overrun error");

        // Now consume the byte
        rx_ready = 1;
        clk.step(1);
        assert(rx_valid == 0, "Expected UART RX valid to deassert after ready handshake");
    }
}
